{
  "schemaVersion": 1,
  "id": "cpextended",
  "version": "${version}",
  "name": "Chat Patches Extended",
  "description": "Unofficial companion for Chat Patches that routes chat messages into separate tabs. Not affiliated with or endorsed by the Chat Patches project.",
  "authors": ["Neptune"],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.itznotneptune.cpextended.CpExtended"]
  },
  "mixins": ["cpextended.mixins.json"],
  "depends": {
    "java": ">=21",
    "minecraft": "=1.21.11",
    "chatpatches": "=8.0.0",
    "fabricloader": ">=${loader_version}",
    "fabric-lifecycle-events-v1": ">=${lifecycle_version}",
    "fabric-rendering-v1": ">=${rendering_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
